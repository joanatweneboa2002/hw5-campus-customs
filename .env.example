# Copy this file to .env (in this folder) and put in your own key.
# Never commit .env.
# The agents call gpt-6-luna through the Portkey gateway (https://api.portkey.ai/v1).
PORTKEY_API_KEY=your-portkey-key-here

# Optional: override the model the agents use (default: gpt-6-luna)
# CAMPUS_MODEL=gpt-6-luna
